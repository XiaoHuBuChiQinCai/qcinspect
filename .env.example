# 复制成 .env 后改掉这三项，再执行 docker compose -f docker-compose.prod.yml up -d
# .env 已在 .gitignore 里，不会被提交

# 数据库密码。部署后改这里不会改掉已有库的密码，改之前先 ALTER USER
DB_PASSWORD=换成强密码

# JWT 签名密钥，至少 32 字节。换掉它 = 所有已登录用户掉线（这是预期的）
JWT_SECRET=换成至少32字节的随机串0123456789abcdef

# 首次启动自动创建的管理员，登录后请立刻在「用户管理」里改密码
ADMIN_USER=admin
ADMIN_PASSWORD=换成强密码
