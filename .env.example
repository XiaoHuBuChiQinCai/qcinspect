# 复制成 .env 后改掉这三项，再执行 docker compose -f docker-compose.prod.yml up -d
# .env 已在 .gitignore 里，不会被提交

# 数据库密码。部署后改这里不会改掉已有库的密码，改之前先 ALTER USER
DB_PASSWORD=换成强密码

# JWT 签名密钥，至少 32 字节。换掉它 = 所有已登录用户掉线（这是预期的）
JWT_SECRET=换成至少32字节的随机串0123456789abcdef

# 首次启动自动创建的管理员，登录后请立刻在「用户管理」里改密码
ADMIN_USER=admin
ADMIN_PASSWORD=换成强密码

# ---- 企业微信推送（可选，不配就是关着） ----
# 用途：审核退回、让步接收这类需要对方动手的事件，除了站内通知，再往手机推一条。
# 配齐三项后把 WECOM_ENABLED 改成 true，并在「用户管理」里给每个人填企业微信账号。
# 注意：AgentId 是数字；Secret 一旦进了 git 历史就要去后台重置，别提交。
WECOM_ENABLED=false
WECOM_CORP_ID=
WECOM_AGENT_ID=0
WECOM_SECRET=
# 消息末尾的手机端入口，例如 http://你的公网IP/h5/ 。不填则消息里不带链接
APP_PUBLIC_URL=
